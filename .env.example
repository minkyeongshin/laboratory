# Stellar Laboratory Environment Configuration
# Copy this file to .env.local and customize as needed.

# =============================================================================
# MOCK MODE (Prototyping Environment)
# =============================================================================
# Enable mock mode to run with mocked Stellar data instead of real network calls.
# This is useful for prototyping new features without backend services.
#
# When enabled:
# - All RPC/Horizon API calls return mock data
# - A mock wallet is auto-connected (no wallet extension needed)
# - Analytics (Amplitude, Google Analytics) are disabled
# - Sentry error tracking is disabled
#
# Set to "true" to enable, remove or set to anything else to disable.
NEXT_PUBLIC_MOCK_MODE=false

# =============================================================================
# OTHER OPTIONS
# =============================================================================
# Disable Google Analytics (optional)
# NEXT_PUBLIC_DISABLE_GOOGLE_ANALYTICS=true

# Use custom network as default (for local Stellar quickstart)
# NEXT_PUBLIC_DEFAULT_NETWORK=custom
